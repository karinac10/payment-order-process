<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
      xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:os="http://www.mulesoft.org/schema/mule/os"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
        http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
        http://www.mulesoft.org/schema/mule/os http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd">

    <munit:config name="get-retrieve-suite" doc:id="ee000001-0001-0001-0001-000000000001"/>

    <!-- ================================================================
         T1 — proc-get-t1-existente-200
         os:contains=true, os:retrieve retorna orden BIAN Completed
         Valida: httpStatus=200, PaymentInstructionStatusType=Completed, Amount
         ================================================================ -->
    <munit:test name="proc-get-t1-existente-200"
                description="GET Retrieve: orden existe en OS → 200 con datos BIAN Completed"
                doc:id="ee000002-0001-0001-0001-000000000002">

        <munit:behavior>
            <!-- Mock os:contains → orderFound = true -->
            <munit-tools:mock-when processor="os:contains" doc:id="ee000003-0001-0001-0001-000000000003">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Check order in OS"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:variables>
                        <munit-tools:variable key="orderFound" value="#[true]"/>
                    </munit-tools:variables>
                </munit-tools:then-return>
            </munit-tools:mock-when>

            <!-- Mock os:retrieve → orderRecord con orden BIAN Completed completa -->
            <munit-tools:mock-when processor="os:retrieve" doc:id="ee000004-0001-0001-0001-000000000004">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Retrieve order from OS"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:variables>
                        <munit-tools:variable key="orderRecord" value='#[output application/java --- {PayerProductInstanceReference: {ProductReference: {ProductIdentification: {ProductIdentification: {IdentifierValue: {Value: "100200300"}}}}}, PayeeProductInstanceReference: {ProductReference: {ProductIdentification: {ProductIdentification: {IdentifierValue: {Value: "900800700"}}}}}, PayeeBankReference: {PartyReference: {PartyIdentification: {PartyIdentification: {IdentifierValue: {Value: "BAT-0088"}}}}}, Amount: {AmountValue: {Value: "150.75"}, AmountCurrency: {Currencycode: "USD"}}, Currency: {Currencycode: "USD"}, DateType: "Creationdate", Date: {DateTimeContent: "2026-10-01T14:32:10-06:00"}, PaymentMechanismType: "ACH", PaymentInstructions: {PaymentInstructionType: "Domesticpayment", PaymentInstructionStatus: {PaymentInstructionStatusType: "Completed", PaymentInstructionStatus: {StatusDateTime: {DateTimeContent: "2026-10-18T20:00:00Z"}}}}, RemittanceInformation: {Text: "Pago de prueba"}}]'/>
                    </munit-tools:variables>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>

        <munit:execution>
            <munit-tools:set-event doc:id="ee000005-0001-0001-0001-000000000005">
                <munit-tools:payload mediaType="application/json" value="#[{}]"/>
                <munit-tools:attributes
                    value='#[output application/java --- {uriParams: {paymentorderid: "test-retrieve-order-001"}, method: "GET", headers: {}, requestPath: "/payment-order/PaymentOrder/test-retrieve-order-001/Retrieve", requestUri: "/payment-order/PaymentOrder/test-retrieve-order-001/Retrieve"}]'/>
                <munit-tools:variables>
                    <munit-tools:variable key="transactionId" value="proc-get-t1-tx-id"/>
                </munit-tools:variables>
            </munit-tools:set-event>
            <flow-ref name="get-payment-order-retrieve-impl-sf" doc:id="ee000006-0001-0001-0001-000000000006"/>
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that doc:id="ee000007-0001-0001-0001-000000000007"
                expression="#[vars.httpStatus]"
                is="#[MunitTools::equalTo(200)]"
                message="httpStatus debe ser 200"/>
            <munit-tools:assert-that doc:id="ee000008-0001-0001-0001-000000000008"
                expression="#[payload.PaymentInstructions.PaymentInstructionStatus.PaymentInstructionStatusType]"
                is="#[MunitTools::equalTo('Completed')]"
                message="PaymentInstructionStatusType debe ser Completed"/>
            <munit-tools:assert-that doc:id="ee000009-0001-0001-0001-000000000009"
                expression="#[payload.Amount.AmountValue.Value]"
                is="#[MunitTools::equalTo('150.75')]"
                message="Amount.AmountValue.Value debe ser 150.75"/>
        </munit:validation>

    </munit:test>

    <!-- ================================================================
         T2 — proc-get-t2-inexistente-404
         os:contains=false → raise-error APP:ORDER_NOT_FOUND
         expectedErrorType captura el error
         ================================================================ -->
    <munit:test name="proc-get-t2-inexistente-404"
                description="GET Retrieve: orden no existe en OS → APP:ORDER_NOT_FOUND"
                expectedErrorType="APP:ORDER_NOT_FOUND"
                doc:id="ee000010-0002-0002-0002-000000000010">

        <munit:behavior>
            <!-- Mock os:contains → orderFound = false -->
            <munit-tools:mock-when processor="os:contains" doc:id="ee000011-0002-0002-0002-000000000011">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Check order in OS"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:variables>
                        <munit-tools:variable key="orderFound" value="#[false]"/>
                    </munit-tools:variables>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>

        <munit:execution>
            <munit-tools:set-event doc:id="ee000012-0002-0002-0002-000000000012">
                <munit-tools:payload mediaType="application/json" value="#[{}]"/>
                <munit-tools:attributes
                    value='#[output application/java --- {uriParams: {paymentorderid: "orden-inexistente-999"}, method: "GET", headers: {}, requestPath: "/payment-order/PaymentOrder/orden-inexistente-999/Retrieve", requestUri: "/payment-order/PaymentOrder/orden-inexistente-999/Retrieve"}]'/>
                <munit-tools:variables>
                    <munit-tools:variable key="transactionId" value="proc-get-t2-tx-id"/>
                </munit-tools:variables>
            </munit-tools:set-event>
            <flow-ref name="get-payment-order-retrieve-impl-sf" doc:id="ee000013-0002-0002-0002-000000000013"/>
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that doc:id="ee000014-0002-0002-0002-000000000014"
                expression="#[true]"
                is="#[MunitTools::equalTo(true)]"
                message="APP:ORDER_NOT_FOUND fue lanzado correctamente (capturado por expectedErrorType)"/>
        </munit:validation>

    </munit:test>

</mule>
