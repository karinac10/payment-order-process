                    </munit-tools:variables>
                </munit-tools:then-return>
            </munit-tools:mock-when>

            <!-- Mock os:contains → idempotencyExists = true -->
            <munit-tools:mock-when processor="os:contains" doc:id="dd000032-0003-0003-0003-000000000032">
