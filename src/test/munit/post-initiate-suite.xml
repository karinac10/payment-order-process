    <!-- ================================================================
         T2 — proc-post-t2-idempotency-replay
         Misma llave + mismo hash → replay desde OS sin llamar System API
         Valida: httpStatus=200, Completed, X-Idempotent-Replayed=true, http:request llamado 0 veces
         ================================================================ -->
    <munit:test name="proc-post-t2-idempotency-replay"
                description="POST Initiate: misma llave + mismo hash → replay sin llamar System API"
                doc:id="dd000020-0002-0002-0002-000000000020">

        <munit:behavior>
            <!-- Mock ee:transform Compute body SHA1 hash → hash conocido -->
            <munit-tools:mock-when processor="ee:transform" doc:id="dd000021-0002-0002-0002-000000000021">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Compute body SHA1 hash"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:variables>
                        <munit-tools:variable key="bodyHash" value="KNOWN_HASH_FOR_REPLAY"/>
                    </munit-tools:variables>
                </munit-tools:then-return>
            </munit-tools:mock-when>

            <!-- Mock os:contains → idempotencyExists = true -->
            <munit-tools:mock-when processor="os:contains" doc:id="dd000022-0002-0002-0002-000000000022">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Check idempotency key"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:variables>
                        <munit-tools:variable key="idempotencyExists" value="#[true]"/>
                    </munit-tools:variables>
                </munit-tools:then-return>
            </munit-tools:mock-when>

            <!-- Mock os:retrieve → cachedEntry con mismo hash -->
            <munit-tools:mock-when processor="os:retrieve" doc:id="dd000023-0002-0002-0002-000000000023">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Retrieve idempotency entry"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:variables>
                        <munit-tools:variable key="cachedEntry" value='#[output application/java --- {bodyHash: "KNOWN_HASH_FOR_REPLAY", response: {PaymentInstructions: {PaymentInstructionStatus: {PaymentInstructionStatusType: "Completed", PaymentInstructionStatus: {StatusDateTime: {DateTimeContent: "2026-10-18T20:00:00Z"}}}}}, orderId: "cached-order-replay-001"}]'/>
                    </munit-tools:variables>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>

        <munit:execution>
            <munit-tools:set-event doc:id="dd000024-0002-0002-0002-000000000024">
                <munit-tools:payload
                    mediaType="application/json"
                    value='#[output application/json --- {PayerProductInstanceReference: {ProductReference: {ProductIdentification: {ProductIdentification: {IdentifierValue: {Value: "100200300"}}}}}, PayeeProductInstanceReference: {ProductReference: {ProductIdentification: {ProductIdentification: {IdentifierValue: {Value: "900800700"}}}}}, PayeeBankReference: {PartyReference: {PartyIdentification: {PartyIdentification: {IdentifierValue: {Value: "BAT-0088"}}}}}, Amount: {AmountValue: {Value: "150.75"}, AmountCurrency: {Currencycode: "USD"}}, Currency: {Currencycode: "USD"}, DateType: "Creationdate", Date: {DateTimeContent: "2026-10-01T14:32:10-06:00"}, PaymentMechanismType: "ACH", PaymentInstructions: {PaymentInstructionType: "Domesticpayment"}, RemittanceInformation: {Text: "Pago de prueba"}}]'/>
                <munit-tools:variables>
                    <munit-tools:variable key="transactionId" value="proc-t2-tx"/>
                    <munit-tools:variable key="idempotencyKey" value="proc-t2-idem-replay"/>
                </munit-tools:variables>
            </munit-tools:set-event>
            <flow-ref name="post-payment-order-initiate-impl-sf" doc:id="dd000025-0002-0002-0002-000000000025"/>
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that doc:id="dd000026-0002-0002-0002-000000000026"
                expression="#[vars.httpStatus]"
                is="#[MunitTools::equalTo(200)]"
                message="httpStatus debe ser 200 en replay"/>
            <munit-tools:assert-that doc:id="dd000027-0002-0002-0002-000000000027"
                expression="#[payload.PaymentInstructions.PaymentInstructionStatus.PaymentInstructionStatusType]"
                is="#[MunitTools::equalTo('Completed')]"
                message="PaymentInstructionStatusType debe ser Completed en replay"/>
            <munit-tools:assert-that doc:id="dd000028-0002-0002-0002-000000000028"
                expression="#[vars.outboundHeaders.'X-Idempotent-Replayed']"
                is="#[MunitTools::equalTo('true')]"
                message="X-Idempotent-Replayed debe ser true en replay"/>
            <munit-tools:verify-call doc:id="dd000029-0002-0002-0002-000000000029"
                processor="http:request"
                times="0"
                message="System API NO debe ser llamada en replay">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="POST System API /transferencias"/>
                </munit-tools:with-attributes>
            </munit-tools:verify-call>
        </munit:validation>

    </munit:test>

